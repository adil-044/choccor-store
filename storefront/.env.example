# Optional — leave unset to use the seeded catalog fallback (recommended for Pages).
# MEDUSA_BACKEND_URL=http://localhost:9000
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# GitHub Pages project subpath (set in CI / npm run build:pages)
# NEXT_PUBLIC_BASE_PATH=/choccor-store

# Set true once retail prices are confirmed (see src/lib/pricing.ts)
# NEXT_PUBLIC_PRICES_CONFIRMED=true
